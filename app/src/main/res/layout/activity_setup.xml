<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".SetupActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvInstructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setup_instructions"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/etCity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/city_hint"
            android:inputType="textCapWords" />

        <TextView
            android:id="@+id/tvTransportLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/transport_type_label" />

        <RadioGroup
            android:id="@+id/rgTransport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbMax"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/transport_max" />

            <RadioButton
                android:id="@+id/rbTelegram"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/transport_telegram" />
        </RadioGroup>

        <TextView
            android:id="@+id/tvMaxChatIdLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/max_chat_id_label" />

        <EditText
            android:id="@+id/etMaxChatId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/max_chat_id_hint"
            android:inputType="text" />

        <TextView
            android:id="@+id/tvTelegramChatIdLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/telegram_chat_id_label" />

        <EditText
            android:id="@+id/etTelegramChatId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/telegram_chat_id_hint"
            android:inputType="text" />

        <TextView
            android:id="@+id/tvTelegramThreadIdLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/telegram_thread_id_label" />

        <EditText
            android:id="@+id/etTelegramThreadId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/telegram_thread_id_hint"
            android:inputType="numberSigned" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/save_button" />
    </LinearLayout>
</ScrollView>
