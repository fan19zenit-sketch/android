<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/sushi_ink"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="8dp"
        android:paddingEnd="18dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/cookPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
                <com.example.simplephotouploader.CameraAuthorRow
                    android:id="@+id/cookChoices"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            
        </LinearLayout>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:minHeight="32dp"
            android:visibility="gone"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="68dp"
                android:layout_weight="1">

                <ImageButton
                    android:id="@+id/settingsButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="top|center_horizontal"
                    android:background="@drawable/clean_history_thumb_bg"
                    android:clipToOutline="true"
                    android:contentDescription="@string/camera_history_label"
                    android:padding="3dp"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/ic_menu_gallery" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|center_horizontal" android:text="История" android:textColor="#FFFFFF" android:fontFamily="@font/golos_label" android:textSize="12sp" />
            </FrameLayout>

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/captureButton"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/clean_shutter_button"
                android:contentDescription="@string/camera_shutter_label" />

            <TextView android:id="@id/shiftShortcut" android:layout_width="0dp" android:layout_weight="1" android:layout_height="56dp" android:gravity="center" android:text="Смена" android:textColor="@android:color/white" android:textStyle="bold" android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
