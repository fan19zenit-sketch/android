<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp"
    android:background="@drawable/clean_card_background" android:orientation="vertical" android:paddingHorizontal="8dp" android:paddingVertical="5dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <com.google.android.material.imageview.ShapeableImageView android:id="@+id/ivThumb" android:layout_width="54dp" android:layout_height="54dp"
            android:background="@drawable/clean_history_thumb_bg" android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Clean.HistoryThumbnail"
            android:contentDescription="@string/camera_history_label" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="14dp" android:orientation="vertical">
            <TextView android:id="@+id/tvHistoryTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:fontFamily="@font/golos_label" android:textColor="@color/clean_text_primary" android:textSize="16sp" />
            <TextView android:id="@+id/tvHistorySubtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="1dp" android:textColor="@color/clean_text_secondary" android:textSize="13sp" />
            <TextView android:id="@+id/tvHistoryStatus" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="1dp" android:background="@drawable/clean_button_secondary"
                android:paddingHorizontal="10dp" android:paddingVertical="1dp"
                android:fontFamily="@font/golos_label" android:textSize="12sp" />
        </LinearLayout>
        <Button android:id="@id/rowActions" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="48dp" android:layout_height="48dp" android:minWidth="0dp" android:padding="0dp" android:text="⋯" android:contentDescription="Действия со снимком" />
    </LinearLayout>
    <LinearLayout android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="end">
        <Button android:id="@+id/btnRetry" style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/history_retry"
            android:textAllCaps="false" android:letterSpacing="0" android:visibility="gone" />
        <Button android:id="@+id/btnDeleteFromChat" style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/history_delete_chat"
            android:textAllCaps="false" android:letterSpacing="0" android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
