<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#141A1D">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="ФОТО В ЧИСТОТУ" android:textSize="12sp" android:letterSpacing="0.14"
            android:fontFamily="sans-serif-medium" android:textColor="#E991B1" />
        <TextView android:id="@+id/headerSubtitle" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="22sp"
            android:fontFamily="sans-serif-medium" android:textColor="#FFFFFF" />
        <TextView android:id="@+id/versionText" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="4dp"
            android:textSize="11sp" android:textColor="#ABB4B9" />
    </LinearLayout>
    <androidx.camera.view.PreviewView android:id="@+id/previewView"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="18dp" android:background="#141A1D">
        <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:minHeight="40dp" android:text="@string/camera_ready"
            android:textSize="14sp" android:textColor="#FFFFFF" android:accessibilityLiveRegion="polite" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:orientation="horizontal" android:gravity="center_vertical">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <ImageButton android:id="@+id/settingsButton" android:layout_width="52dp" android:layout_height="52dp"
                    android:background="@drawable/clean_history_thumb_bg" android:scaleType="centerCrop"
                    android:clipToOutline="true" android:padding="3dp"
                    android:src="@android:drawable/ic_menu_gallery" android:contentDescription="@string/camera_history_label" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:text="@string/camera_history_label" android:textSize="12sp" android:textColor="#D8DFE2" />
            </LinearLayout>
            <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/captureButton"
                android:layout_width="78dp" android:layout_height="78dp" android:background="@drawable/clean_shutter_button"
                android:contentDescription="@string/camera_shutter_label" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:gravity="center" android:padding="12dp" android:text="@string/camera_hint"
                android:textSize="12sp" android:textColor="#ABB4B9" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
