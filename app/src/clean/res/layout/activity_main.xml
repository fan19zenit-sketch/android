<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sushi_ink"
    android:orientation="vertical">

    <TextView
        android:id="@+id/headerSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="44dp" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:textColor="#FFFFFF" android:fontFamily="@font/manrope_heading" android:textSize="20sp" />

    <TextView
        android:id="@+id/versionText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <include layout="@layout/camera_stage" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

    <include layout="@layout/camera_console" />
</LinearLayout>
