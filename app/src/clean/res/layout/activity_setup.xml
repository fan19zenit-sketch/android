<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/clean_surface"
    android:fillViewport="true"
    tools:context=".SetupActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="@string/clean_setup_title"
            android:textColor="@color/clean_text_primary"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvInstructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif-medium"
            android:lineSpacingExtra="2dp"
            android:text="@string/setup_instructions_clean"
            android:textColor="@color/clean_text_secondary"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/clean_card_background"
            android:elevation="6dp"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvCityLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/clean_city_label"
                android:textColor="@color/clean_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etCity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/clean_input_background"
                android:fontFamily="sans-serif-medium"
                android:hint="@string/city_hint"
                android:inputType="textCapWords"
                android:minHeight="60dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp"
                android:textColor="@color/clean_text_primary"
                android:textCursorDrawable="@null"
                android:textColorHint="@color/clean_text_secondary" />

            <TextView
                android:id="@+id/tvHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif"
                android:text="@string/clean_setup_hint"
                android:textColor="@color/clean_text_secondary"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/clean_button_primary"
                android:fontFamily="sans-serif-black"
                android:minHeight="58dp"
                android:text="@string/clean_save_button"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvTransportLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            tools:visibility="gone" />

        <RadioGroup
            android:id="@+id/rgTransport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            tools:visibility="gone">

            <RadioButton
                android:id="@+id/rbMax"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/transport_max" />

            <RadioButton
                android:id="@+id/rbTelegram"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/transport_telegram" />
        </RadioGroup>

        <TextView
            android:id="@+id/tvMaxChatIdLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            tools:visibility="gone" />

        <EditText
            android:id="@+id/etMaxChatId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            tools:visibility="gone" />

        <TextView
            android:id="@+id/tvTelegramChatIdLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            tools:visibility="gone" />

        <EditText
            android:id="@+id/etTelegramChatId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            tools:visibility="gone" />

        <TextView
            android:id="@+id/tvTelegramThreadIdLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            tools:visibility="gone" />

        <EditText
            android:id="@+id/etTelegramThreadId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            tools:visibility="gone" />
    </LinearLayout>
</ScrollView>
