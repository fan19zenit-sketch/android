<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/clean_surface"
    android:fillViewport="true"
    tools:context=".SetupActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <ImageView android:layout_width="78dp" android:layout_height="64dp" android:layout_marginBottom="12dp" android:scaleType="fitCenter" android:contentDescription="@null" android:src="@drawable/sushi_go_mark" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/manrope_heading"
            android:text="@string/clean_setup_title"
            android:textColor="@color/clean_text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView android:id="@+id/tvInstructions" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/clean_card_background"
            android:elevation="0dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/tvCityLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/golos_label"
                android:text="@string/clean_city_label"
                android:textColor="@color/clean_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etCity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/clean_input_background"
                android:fontFamily="@font/golos_label"
                android:hint="@string/city_hint"
                android:inputType="textCapWords"
                android:minHeight="50dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:textColor="@color/clean_text_primary"
                android:textCursorDrawable="@null"
                android:textColorHint="@color/clean_text_secondary" />



            <TextView
                android:id="@+id/tvDeviceMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/golos_label"
                android:text="@string/device_mode_label"
                android:textColor="@color/clean_text_primary"
                android:textSize="16sp" />

            <RadioGroup
                android:id="@+id/rgDeviceMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <RadioButton
                    android:id="@+id/rbDeviceMain"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/device_mode_main"
                    android:textColor="@color/clean_text_primary" />
                <RadioButton
                    android:id="@+id/rbDevicePizza"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/device_mode_pizza"
                    android:textColor="@color/clean_text_primary" />
            </RadioGroup>

            <Button
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/clean_button_primary"
                android:fontFamily="@font/manrope_heading"
                android:minHeight="58dp"
                android:text="@string/clean_save_button"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button android:id="@+id/btnSetupSupport" style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
            android:layout_marginTop="16dp" android:text="@string/support_title" android:textAllCaps="false" />

        <TextView
            android:id="@+id/tvTransportLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            tools:visibility="gone" />

        <RadioGroup
            android:id="@+id/rgTransport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            tools:visibility="gone">

            <RadioButton
                android:id="@+id/rbMax"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/transport_max" />

            <RadioButton
                android:id="@+id/rbTelegram"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/transport_telegram" />
        </RadioGroup>

        <TextView
            android:id="@+id/tvMaxChatIdLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            tools:visibility="gone" />

        <EditText
            android:id="@+id/etMaxChatId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            tools:visibility="gone" />

        <TextView
            android:id="@+id/tvTelegramChatIdLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            tools:visibility="gone" />

        <EditText
            android:id="@+id/etTelegramChatId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            tools:visibility="gone" />

        <TextView
            android:id="@+id/tvTelegramThreadIdLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            tools:visibility="gone" />

        <EditText
            android:id="@+id/etTelegramThreadId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            tools:visibility="gone" />
    </LinearLayout>
</ScrollView>
