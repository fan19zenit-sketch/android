<resources>
    <style name="Theme.SimplePhotoUploader" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/clean_pink</item>
        <item name="colorPrimaryVariant">@color/clean_pink_dark</item>
        <item name="colorSecondary">@color/clean_pink</item>
        <item name="colorOnPrimary">@color/photo_on_pink</item>
        <item name="colorSurface">@color/clean_surface_card</item>
        <item name="colorOnSurface">@color/photo_text</item>
        <item name="android:statusBarColor">@color/clean_black</item>
        <item name="android:navigationBarColor">@color/clean_black</item>
        <item name="android:windowBackground">@color/clean_surface</item>
        <item name="colorOnSecondary">@color/photo_on_pink</item>
        <item name="buttonStyle">@style/Widget.Photo.Button</item>
        <item name="android:fontFamily">@font/golos_body</item>
        <item name="fontFamily">@font/golos_body</item>
        <item name="sushiHeadingFont">@font/manrope_heading</item>
        <item name="sushiLabelFont">@font/golos_label</item>
    </style>
    <style name="Theme.SimplePhotoUploader.NoActionBar" parent="Theme.SimplePhotoUploader" />
    <style name="Widget.Photo.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:fontFamily">@font/golos_label</item>
        <item name="cornerRadius">14dp</item>
    </style>
</resources>
